{
  "name": "neighborwalk",
  "version": "1.0.0",
  "private": true,
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "prepare:map-worker": "node scripts/copy-maplibre-worker.mjs",
    "postinstall": "npm run prepare:map-worker",
    "prebuild": "npm run prepare:map-worker",
    "postbuild": "node scripts/prepare-offline.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "sandbox:start": "tsx scripts/sandbox.ts start",
    "sandbox:stop": "tsx scripts/sandbox.ts stop",
    "sandbox:seed": "tsx scripts/sandbox.ts seed",
    "sandbox:verify": "tsx scripts/sandbox.ts verify",
    "sandbox:status": "tsx scripts/sandbox.ts status",
    "test": "vitest run --config vitest.config.ts",
    "test:database": "node scripts/test-database.mjs",
    "test:browser": "playwright test",
    "backup:database": "node scripts/backup-database.mjs",
    "backup:rehearse:local": "node scripts/rehearse-backup.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "lint": "eslint ."
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "idb": "^8.0.3",
    "lucide-react": "^1.28.0",
    "maplibre-gl": "6.4.1",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "resend": "6.27.0",
    "server-only": "0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.3.4",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "16.4.0",
    "supabase": "2.117.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vitest": "4.1.11"
  },
  "type": "module"
}
