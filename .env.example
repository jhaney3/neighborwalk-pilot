# Paste one protected, origin-restricted MapTiler key here. The app builds the style URL for you.
NEXT_PUBLIC_MAPTILER_KEY=PASTE_YOUR_MAPTILER_KEY_HERE

# Optional advanced override for a different MapLibre-compatible style URL.
NEXT_PUBLIC_MAP_STYLE_URL=

# Supabase project URL and browser-safe publishable key. Never use a secret or service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Optional GET endpoint: ?lat={latitude}&lng={longitude} -> { "address": "..." }
# Proxy your paid geocoder through your own backend; do not expose secret provider keys here.
NEXT_PUBLIC_GEOCODER_URL=

# Used when generating canonical links outside the hosted Sites environment.
NEXT_PUBLIC_SITE_URL=https://neighborwalk.example.org
