# Paste one protected, origin-restricted MapTiler key here. The app builds the style URL for you.
NEXT_PUBLIC_MAPTILER_KEY=PASTE_YOUR_MAPTILER_KEY_HERE

# Optional advanced override for a MapLibre-compatible style and asset host.
# Production CSP permits this configured origin; cross-origin sources embedded
# inside the style must still be explicitly supported before deployment.
NEXT_PUBLIC_MAP_STYLE_URL=

# Local test database. Run npm run sandbox:start to write its key to .env.local.
# Production settings belong in Vercel's Production environment, not on this device.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional HTTPS GET endpoint: ?lat={latitude}&lng={longitude} -> { "address": "..." }
# Proxy your paid geocoder through your own backend; do not expose secret provider keys here.
NEXT_PUBLIC_GEOCODER_URL=

# Server-only key used to load ESV passages inside conversation guides.
ESV_API_KEY=

# Canonical production origin used for metadata and future absolute links.
NEXT_PUBLIC_SITE_URL=https://neighborwalk-pilot.vercel.app

# Public enrollment stays closed until the operator has reviewed these details.
NEIGHBORWALK_OPERATOR_NAME=
NEIGHBORWALK_SUPPORT_EMAIL=
NEIGHBORWALK_POLICIES_APPROVED=false
NEIGHBORWALK_PILOT_OPEN=false

# Opt-in reminders: server-only. Keep disabled until docs/email-reminders.md
# has been completed, including domain, webhook and real delivery verification.
# Do not put production credentials in local test configuration.
NEIGHBORWALK_REMINDERS_ENABLED=false
NEIGHBORWALK_EMAIL_VERIFIED=false
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
REMINDER_FROM_EMAIL=
# Independent random secrets, each at least 32 characters. Keep the unsubscribe
# key stable; during rotation retain the previous key so older links still work.
CRON_SECRET=
REMINDER_UNSUBSCRIBE_SECRET=
REMINDER_UNSUBSCRIBE_PREVIOUS_SECRET=
